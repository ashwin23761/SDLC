OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2:3b
APP_PORT=8501
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=finance_req_agents
MONGODB_COLLECTION=runs
FINANCE_REQ_MONGODB_ENABLED=1
FINANCE_REQ_AUTH_REQUIRED=0
# To enable secure mode, configure a private users.json under secrets/ and set
# FINANCE_REQ_AUTH_REQUIRED=1 plus a Fernet key in FINANCE_REQ_AUDIT_ENCRYPTION_KEY.
